doctype html
html(lang="en")
  head
    include includes/head.pug
    title Game over
    link(rel="stylesheet" href="/css/end.css")
  body
    main.end.card
      p.eyebrow Game over
      h1 #{finalScores[0].name} wins
      h2 Leaderboard
      ol#leaderboard
        each player, i in finalScores
          li(class=player.totalScore === finalScores[0].totalScore ? 'winner' : '')
            span.place= i + 1
            span.name #{player.name}
            span.score #{player.totalScore}
      a.btn(href="/") Play again
    footer#footer
      include includes/foot.pug
