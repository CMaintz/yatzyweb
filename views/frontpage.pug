doctype html
html(lang="en")
  head
    include includes/head.pug
    title Yatzy lobby
    link(rel="stylesheet" href="/css/front.css")
    script(src="/js/clientFront.js" defer)
  body
    main.lobby.card
      header.brand
        img(src="/images/dice_5.png" alt="")
        h1 Yatzy
      p.lede Hot-seat Yatzy for two or more players at one screen.

      section
        h2 Players
        ol#userList
          each player in players
            li.player= player.name
        p#noPlayersMessage.muted(hidden=players.length > 0) No players yet.

      if !gameStarted
        form#addPlayerForm.add-player
          label.visually-hidden(for="playername") Name
          input#playername(type="text" placeholder="Player name" maxlength="30" autocomplete="off" required)
          button.btn.secondary(type="submit") Add
        button.btn.start-button#startButton(type="button" disabled=players.length < 2) Start game
        p#status.status(role="status" aria-live="polite")
      else
        .game-in-progress
          p A game is already running in this browser.
          a.btn(href="/play") Continue game
    footer#footer
      include includes/foot.pug
